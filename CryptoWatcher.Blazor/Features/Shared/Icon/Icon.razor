<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "logo":
            <path d="M6 4v3M6 17v3M12 3v4M12 15v6M18 6v3M18 16v2" />
            <rect x="4" y="7" width="4" height="10" rx="1" />
            <rect x="10" y="7" width="4" height="8" rx="1" />
            <rect x="16" y="9" width="4" height="7" rx="1" />
            break;
        case "sidebar":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M9 4v16" />
            break;
        case "prices":
            <path d="M3 12h4l3-7 4 14 3-7h4" />
            break;
        case "l2":
            <path d="M4 6h10M4 10h16M4 14h7M4 18h13" />
            break;
        case "l3":
            <path d="m12 3-9 5 9 5 9-5-9-5z" />
            <path d="m3 13 9 5 9-5" />
            break;
        case "liquidity":
            <path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11z" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "moon":
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public int Size { get; set; } = 16;
}
