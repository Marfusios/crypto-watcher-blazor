@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="shell">
    <HeaderBar />

    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="backdrop" @onclick="CloseSidebarOnMobile"></div>

    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // The expanded sidebar overlays the page on phones, hide it after navigation
        await CloseSidebarOnMobile();
    }

    private async Task CloseSidebarOnMobile()
    {
        await JS.InvokeVoidAsync("cw.closeSidebarOnMobile");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
